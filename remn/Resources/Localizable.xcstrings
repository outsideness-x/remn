    "srs.hard" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "recalled with real effort" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "вспомнили с большим трудом" } } } },
    "srs.history" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Every answer is kept in the review history. Undo restores the card to its exact previous state." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Каждый ответ сохраняется в истории. Отмена возвращает карточку точно в предыдущее состояние." } } } },
    "srs.intro" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "remn does not use a fixed calendar. It predicts when each memory is about to fade and brings the card back around then." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "remn не использует фиксированный календарь. Он предсказывает, когда память начнёт угасать, и возвращает карточку примерно тогда." } } } },
    "srs.later" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "later" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "позже" } } } },
    "srs.memory.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "FSRS tracks how stable and difficult each card is. Successful recall strengthens it, so the next interval usually grows." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "FSRS отслеживает устойчивость и сложность каждой карточки. Успешное вспоминание укрепляет память, поэтому следующий интервал обычно растёт." } } } },
    "srs.memory.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "memory, not a timer" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "память, а не таймер" } } } },
    "srs.muchLater" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "much later" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "намного позже" } } } },
    "srs.now" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "now" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "сейчас" } } } },
    "srs.queue.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Overdue reviews come first, then new cards. A card scheduled for later is not pulled forward just to fill the chosen session size." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сначала идут просроченные повторения, затем новые карточки. Карточка, назначенная на позже, не появляется раньше только ради заполнения сессии." } } } },
    "srs.queue.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "the queue has rules" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "у очереди есть правила" } } } },
    "srs.ratings.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The four times under the buttons are real predictions. Your rating selects one of those next states." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Четыре времени под кнопками — реальные прогнозы. Ваша оценка выбирает одно из этих следующих состояний." } } } },
    "srs.ratings.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "your answer teaches it" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "ваш ответ обучает алгоритм" } } } },
    "srs.retention.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "At 90%, FSRS aims for roughly a nine-in-ten chance of recall when a card returns. Raising it shortens intervals and creates more reviews." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "При 90% FSRS стремится примерно к девяти шансам из десяти вспомнить карточку при следующем показе. Более высокий процент сокращает интервалы и добавляет повторения." } } } },
    "srs.retention.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "90% is the bargain" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "90% — разумный компромисс" } } } },
    "srs.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "how remn remembers" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "как remn запоминает" } } } },
