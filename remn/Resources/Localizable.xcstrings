    "subject.delete.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "all decks and cards in this subject will be deleted" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "все колоды и карточки предмета будут удалены" } } } },
