    "study.allDue" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "all due" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "все срочные" } } } },
    "study.availableNow" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "available now" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "доступно сейчас" } } } },
