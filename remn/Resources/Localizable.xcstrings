    "study.continue" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "continue study" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "продолжить" } } } },
    "study.custom" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "custom" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "своё" } } } },
    "study.deck" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "study this deck" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "учить эту колоду" } } } },
    "study.howMany" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "how many cards?" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "сколько карточек?" } } } },
    "study.inSession" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "in this session" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "в этой сессии" } } } },
    "study.more" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "study more" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "ещё" } } } },
    "study.noneAvailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "nothing due." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "ничего не пора." } } } },
    "study.noneAvailable.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "there are no due or new cards in this scope" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "здесь нет срочных или новых карточек" } } } },
    "study.rate" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "how did recall feel?" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "как вспомнилось?" } } } },
    "study.ratingsHelp.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "again means you did not recall it. hard means you did recall it, but with serious difficulty. good is normal effort; easy is immediate and confident." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "«снова» — не вспомнили. «тяжело» — вспомнили, но с большим трудом. «хорошо» — обычное усилие, «легко» — сразу и уверенно." } } } },
    "study.ratingsHelp.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ratings" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "оценки" } } } },
    "study.reviews" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "reviews" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "повторений" } } } },
